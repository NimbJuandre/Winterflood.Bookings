{
  "info": {
    "name": "Winterflood.Bookings API",
    "_postman_id": "b1a7f6d2-3c4e-4a1b-9f2d-000000000001",
    "description": "Booking API endpoints (Create, Get, Update, Delete) plus health checks. BookingType serializes as a string: Apartment, Vehicle, Show. The Create request stores the returned id into the bookingId collection variable so Get/Update/Delete chain automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', body.id);",
                  "pm.test('Response has an id', function () { pm.expect(body.id).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Alice\",\n  \"bookingType\": \"Apartment\",\n  \"itemName\": \"Seaside flat\",\n  \"startDate\": \"2026-06-01\",\n  \"endDate\": \"2026-06-07\",\n  \"quantity\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get Booking By Id",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });" ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Update Booking",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });" ] } }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Alice B.\",\n  \"bookingType\": \"Vehicle\",\n  \"itemName\": \"Mountain cabin\",\n  \"startDate\": \"2026-07-01\",\n  \"endDate\": \"2026-07-05\",\n  \"quantity\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Delete Booking",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 204 No Content', function () { pm.response.to.have.status(204); });" ] } }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Create Booking - Invalid (validation 400)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 400 Bad Request', function () { pm.response.to.have.status(400); });" ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"\",\n  \"bookingType\": \"Apartment\",\n  \"itemName\": \"\",\n  \"startDate\": \"2026-06-10\",\n  \"endDate\": \"2026-06-01\",\n  \"quantity\": 0\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Health", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } } },
        { "name": "Health Ready", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] } } },
        { "name": "Health Live", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health/live", "host": ["{{baseUrl}}"], "path": ["health", "live"] } } }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5249" },
    { "key": "bookingId", "value": "" }
  ]
}
